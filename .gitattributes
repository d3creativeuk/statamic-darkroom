# Kept out of the package Composer installs. The artwork is for the README on
# GitHub; client sites never need it.
/art             export-ignore
/tests           export-ignore
/CLAUDE.md       export-ignore
/phpunit.xml     export-ignore
# Only needed to rebuild the JS. Sites get the compiled public/build, and the
# lock file points at a host checkout that does not exist anywhere else.
/package.json      export-ignore
/package-lock.json export-ignore
/vite.config.js    export-ignore
/.github         export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
